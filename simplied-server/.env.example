# Copy to .env and fill in. NEVER commit .env or put these values in the website code.

# --- LLM provider -------------------------------------------------------------
# gemini | groq | none   (empty = gemini if GEMINI_API_KEY is set, otherwise the rules engine only)
LLM_PROVIDER=
GEMINI_API_KEY=
# Recommended low-cost model as of Oct 2026. Check https://ai.google.dev/gemini-api/docs/models for current IDs.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional alternative provider (OpenAI-compatible). Set GROQ_MODEL from your Groq console.
GROQ_API_KEY=
GROQ_MODEL=

# --- Limits -------------------------------------------------------------------
LLM_TIMEOUT_MS=9000
# Max LLM calls per day across all visitors (protects the free quota). Beyond this, the rules engine answers.
LLM_DAILY_LIMIT=1000
# Per-visitor (IP) limits on /api/chat
RATE_PER_MINUTE=15
RATE_PER_DAY=300

# --- Server -------------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
# Folder with index.html (relative to this file)
SITE_DIR=../simplied-site
# Only needed if the website is hosted on a different domain than this server, comma-separated
ALLOWED_ORIGINS=
# Set to 1 when running behind a reverse proxy / load balancer so rate limits use the real client IP
TRUST_PROXY=0
SUPPORT_EMAIL=info@simpliedtech.com
# off = no request logs (logs never contain message text either way)
LOG=on
